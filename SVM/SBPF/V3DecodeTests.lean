import SVM.SBPF.Decode

namespace SVM.SBPF.V3DecodeTests

-- CALL_REG in V3 takes the destination nibble as its target register.
example : Decode.decodeInsn (Decode.bytesOfHex "8d01000000000000") #[0] 0 [] .v3 =
    some (.callx .r1, 8) := by
  native_decide

-- The endian opcodes are verifier-valid only at widths 16, 32, and 64.
example : (Decode.decodeInsn (Decode.bytesOfHex "d400000020000000") #[0] 0 [] .v3).isSome = true := by
  native_decide
example : (Decode.decodeInsn (Decode.bytesOfHex "dc00000020000000") #[0] 0 [] .v3).isSome = true := by
  native_decide
example : Decode.decodeInsn (Decode.bytesOfHex "dc00000008000000") #[0] 0 [] .v3 =
    none := by native_decide

