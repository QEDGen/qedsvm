/-
  Load-time verifier conformance (#91): Firedancer's `instr_test` vectors
  (`src/flamenco/vm/instr_test/{v0,v3}/*.instr`, ported by the fd_vm spike).
  Each entry is a program's `.text` (hex) and whether the verifier rejects it
  (`vfy`). qedsvm's decoder must fail exactly on the rejected ones; every other
  vector (`ok` or a runtime `err`) must decode. fd_vm, QEMU and the Sail model
  agree with these expectations, and so does agave's `RequisiteVerifier`.
-/
import SVM.SBPF.Decode

namespace SVM.SBPF.VerifierVectors

/-- `true` iff the decoder rejects exactly the verifier-rejected vectors. -/
def conforms (version : Decode.Version) (vs : Array (String × Bool)) : Bool :=
  vs.all fun (hex, rejected) =>
    (Decode.decodeProgram (Decode.bytesOfHex hex) [] version).isNone == rejected

