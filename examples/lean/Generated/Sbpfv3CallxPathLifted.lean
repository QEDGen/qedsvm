/-
  Generated by `qedlift` from `tests/fixtures/sbpfv3_callx_path.so`.

End-to-end V3 lift:
1. The complete V3 ELF and its loaded text are pinned by a theorem.
2. Walked instructions are decoded with V3 semantics and pinned
against those exact text bytes by `native_decide`.
3. The symbolic walker emits a selected-path `cuTripleWithinMem`
theorem, closed by the instruction specs.
-/

import SVM.SBPF.Decode
import SVM.SBPF.RunnerBridge
import SVM.SBPF.Macros
import SVM.SBPF.SatWitness

set_option maxRecDepth 65536
set_option maxHeartbeats 4000000

namespace Examples.Lifted.Sbpfv3CallxPathLifted

open SVM.SBPF

-- NOTE: `Sbpfv3CallxPathLiftedBytes` + `Sbpfv3CallxPathLiftedInsns` + `Sbpfv3CallxPathLifted_decodes` omitted — the .text
-- is 56 bytes, which blows `maxRecDepth` as a ByteArray literal.
-- The byte→insn link is pinned instead by `Sbpfv3CallxPathLifted_decode_pins` below:
-- the `.text` is embedded as a hex string (`Sbpfv3CallxPathLiftedText`) and every
-- walked PC's decode is checked by `native_decide` against the
-- exact instruction the Hoare triple's `CodeReq` claims there
-- (soundness-audit H8).

/-- The `.text` bytes of the binary, embedded as hex (whitespace-insensitive;
    see `Decode.bytesOfHex`). 56 bytes. -/
def Sbpfv3CallxPathLiftedText : ByteArray := Decode.bytesOfHex "
  180200002800000000000000010000008d02000000000000b7000000000000009500000000000000b7000000070000009500000000000000
  "

/-- Byte-slot → logical-PC map for `Sbpfv3CallxPathLiftedText` (pass 1 of the decoder),
    computed in-kernel — jump-target resolution in the pins below depends on
    the `lddw` positions of the WHOLE text, not just the pinned windows. -/
def Sbpfv3CallxPathLiftedSlotMap : Array Nat := Decode.buildSlotMap Sbpfv3CallxPathLiftedText

/-- V3 uses relative internal calls; this registry is empty. -/
def Sbpfv3CallxPathLiftedFnRegistry : List (Nat × Nat) := []

/-- Every walked instruction is decoded from the pinned V3 text. -/
theorem Sbpfv3CallxPathLifted_decode_pins :
    ([0, 16, 40, 48, 24].map fun off =>
      Decode.decodeInsn Sbpfv3CallxPathLiftedText Sbpfv3CallxPathLiftedSlotMap off Sbpfv3CallxPathLiftedFnRegistry .v3) = [
      some (.lddw .r2 (4294967336), 16),
      some (.callx .r2, 8),
      some (.mov64 .r0 (.imm (7)), 8),
      some (.exit, 8),
      some (.mov64 .r0 (.imm (0)), 8)
    ] := by
  native_decide

/-- Complete V3 ELF bytes, including `e_flags` and program headers. -/
def Sbpfv3CallxPathLiftedElf : ByteArray := Decode.bytesOfHex "
  7f454c460201010000000000000000000300f7000100000000000000010000004000000000000000000000000000000003000000400038000100000000000000
  01000000010000007800000000000000000000000100000000000000010000003800000000000000380000000000000008000000000000001802000028000000
  00000000010000008d02000000000000b7000000000000009500000000000000b7000000070000009500000000000000
  "

theorem Sbpfv3CallxPathLifted_v3_elf_text :
(Elf.loadV3 Sbpfv3CallxPathLiftedElf).map (·.textBytes) =
some Sbpfv3CallxPathLiftedText := by native_decide

/-- Every indirect-call target on this path, resolved through the text
    region the V3 loader builds from the pinned ELF. -/
theorem Sbpfv3CallxPathLifted_v3_callx_resolves (inputLen : Nat) :
    ((Elf.loadV3 Sbpfv3CallxPathLiftedElf).map fun program =>
      [resolveCallx (Runner.v3Regions program inputLen) (toU64 4294967336)]) =
      some [some 4] := by
  simp only [Runner.resolveCallx_v3Regions_input_indep]
  native_decide

/-! ## Symbolically lifted Hoare triple

Synthesised by qedlift's symbolic executor walking the
decoded insns left-to-right. Closed by `sl_block_auto`. -/

open Memory in
theorem Sbpfv3CallxPathLifted_lifted_spec
    (vR2Old vR6Old vR7Old vR8Old vR9Old vR10Old vR0Old : Nat)
    : cuTripleWithinMem 5 0 0 3
      ((((((CodeReq.singleton 0 (.lddw .r2 (4294967336))).union
        (CodeReq.singleton 1 (.callx .r2))).union
        (CodeReq.singleton 4 (.mov64 .r0 (.imm (7))))).union
        (CodeReq.singleton 5 (.exit))).union
        (CodeReq.singleton 2 (.mov64 .r0 (.imm (0))))))
      ((.r2 ↦ᵣ vR2Old) **
      (.r6 ↦ᵣ vR6Old) **
      (.r7 ↦ᵣ vR7Old) **
      (.r8 ↦ᵣ vR8Old) **
      (.r9 ↦ᵣ vR9Old) **
      (.r10 ↦ᵣ vR10Old) **
      (.r0 ↦ᵣ vR0Old) ** callStackIs [])
      ((.r2 ↦ᵣ toU64 4294967336) **
      (.r6 ↦ᵣ vR6Old) **
      (.r7 ↦ᵣ vR7Old) **
      (.r8 ↦ᵣ vR8Old) **
      (.r9 ↦ᵣ vR9Old) **
      (.r10 ↦ᵣ vR10Old) **
      (.r0 ↦ᵣ toU64 0) ** callStackIs [])
      (fun rt => resolveCallx rt (toU64 4294967336) = some 4) := by
  have h_0 := lddw_spec .r2 4294967336 (vR2Old) 0 (by decide)
  have h_1 := callx_v3_spec .r2 (toU64 4294967336) 4 [] (vR6Old) (vR7Old) (vR8Old) (vR9Old) (vR10Old) 1
  have h_4 := mov64_imm_spec .r0 7 (vR0Old) 4 (by decide)
  have h_5 := exit_pops_spec ⟨1 + 1, (vR6Old), (vR7Old), (vR8Old), (vR9Old), (vR10Old)⟩ [] (vR6Old) (vR7Old) (vR8Old) (vR9Old) (vR10Old + 4096) 5
  dsimp only at h_5
  have h_2 := mov64_imm_spec .r0 0 (toU64 7) 2 (by decide)
  sl_block_iter [h_0, h_1, h_4, h_5, h_2]

/-! ## Satisfiability witness (soundness-audit H8)

The triple's precondition is SATISFIABLE at the concrete
assignment below — an overlapping (vacuous) sepConj would fail
`native_decide` here, so vacuity cannot ship. The guards pin
each `addrK` literal to its `h_addrK` defining equation at the
assignment; the witness goal is the theorem's precondition with
the variables instantiated, so the reflected `SatWitness` atoms
are tied to the real pre by the elaborator's defeq check.
Value-level path hypotheses (`h_branch*`) are not certified
consistent — they are outside the overlap-vacuity class this
guards against. -/

open Memory in
example : ∃ s,
    ((.r2 ↦ᵣ 0) **
      (.r6 ↦ᵣ 0) **
      (.r7 ↦ᵣ 0) **
      (.r8 ↦ᵣ 0) **
      (.r9 ↦ᵣ 0) **
      (.r10 ↦ᵣ 0) **
      (.r0 ↦ᵣ 0) ** callStackIs []) s := by
  have w := SatWitness.sat_witness
    [.reg .r2 0,
     .reg .r6 0,
     .reg .r7 0,
     .reg .r8 0,
     .reg .r9 0,
     .reg .r10 0,
     .reg .r0 0,
     .callStack []]
    (by native_decide)
  exact w

end Examples.Lifted.Sbpfv3CallxPathLifted
