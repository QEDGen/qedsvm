/-
  Pinned sBPF V3 execution proof. The embedded ELF is generated by
  `qedsvm-rs/tests/fixtures/build_sbpfv3_static_path.py` and has no section
  headers. `native_decide` checks the actual V3 program-header load, decode,
  branch, relative call, static syscall, and final state.
-/
import SVM.SBPF.Runner

namespace Generated.SbpfV3StaticPath

open SVM.SBPF

def elf : ByteArray := Decode.bytesOfHex
  ""

theorem is_v3 : Elf.readVersion elf = some .v3 := by native_decide

theorem decoded_path : (Elf.loadV3 elf).bind (fun p =>
    Decode.decodeProgram p.textBytes [] .v3) = some #[
      .mov64 .r0 (.imm 1),
      .jmp32 .eq .r0 (.imm 1) 3,
      .mov64 .r0 (.imm 99),
      .call_local 5,
      .exit,
      .call .sol_log_64_,
      .mov64 .r0 (.imm 0),
      .exit
    ] := by native_decide

theorem executes_successfully :
    (Runner.runElf elf).map (fun s => (s.exitCode, s.log.size)) =
      some (some 0, 1) := by native_decide

end Generated.SbpfV3StaticPath
