/-- **Readable requirements for edge 53.** A run from the entrypoint that stands at the
    edge started from an input with the stated lengths that meets the edge's checks and one
    instruction's checks. -/
theorem readable53 (s0 : State)
    (hlen : lengths53 s0) (hpc : s0.pc = 6) (hcs : s0.callStack = [])
    (h1 : s0.regs.r1 = INPUT_START) (h10 : s0.regs.r10 = STACK_TOP) (n : Nat)
    (hend : (executeFn (Runner.fetchFromArray prog) s0 n).callStack = [] ∧
      (executeFn (Runner.fetchFromArray prog) s0 n).pc = 53) :
    requires53 s0 ∧ (requires53_ix0 s0 ∨ requires53_ix1 s0 ∨ requires53_ix2 s0) := by
  obtain ⟨hdom, c, ip, iq, hr, hip, hiq⟩ :=
    inputs53 prog insns?_eq s0 (assumed_of_lengths53 s0 hlen) hpc hcs (init_concrete s0 h1 h10) n hend
  refine ⟨requires53_of s0 hdom, ?_⟩
  simp only [iroutes53, List.mem_cons, List.mem_nil_iff, or_false, Prod.mk.injEq] at hr
  rcases hr with ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩
  · exact Or.inl (requires53_ix0_of s0 hip hiq)
  · exact Or.inr (Or.inl (requires53_ix1_of s0 hip hiq))
  · exact Or.inr (Or.inr (requires53_ix2_of s0 hip hiq))

end Examples.LabelVaultV3
