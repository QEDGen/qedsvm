def iroutes53 : List IRoute :=
  [(35, ipre53_35, ipost53_35), (54, ipre53_54, ipost53_54), (87, ipre53_87, ipost53_87)]

theorem pins53 : insns?.all (fun insns =>
    let m := absMap53 insns
    (idom53.all (iguardCheck m) &&
      iroutes53.all fun (_, ip, iq) => ip.all (iguardCheck m) && iq.all (iguardCheck m)) &&
    iguardsMatch dom53 routes53 idom53 iroutes53) = true := by native_decide

/-- **Input conditions for edge 53.** A run from the entrypoint that stands at the edge
    started from an input that passed the pinned dominating guards and one route's pinned
    guards, given the assumed lengths. -/
theorem inputs53 (insns : Array Insn) (hp : insns? = some insns) (s0 : State)
    (hasm : AssumedHolds s0 assumed53) (hpc : s0.pc = 6) (hcs : s0.callStack = [])
    (hinit : Concrete s0 init s0) (n : Nat)
    (hend : (executeFn (Runner.fetchFromArray insns) s0 n).callStack = [] ∧
      (executeFn (Runner.fetchFromArray insns) s0 n).pc = 53) :
    (∀ ig ∈ idom53, ig.holds s0) ∧
    ∃ c ip iq, (c, ip, iq) ∈ iroutes53 ∧ (∀ ig ∈ ip, ig.holds s0) ∧ (∀ ig ∈ iq, ig.holds s0) := by
  have hpath := check53
  rw [hp, Option.all_some] at hpath
  have habs := absOk53
  rw [hp, Option.all_some] at habs
  have hpins := pins53
  rw [hp, Option.all_some] at hpins
  simp only [Bool.and_eq_true] at hpins
  exact edge_input_conditionsA _ noret (noret_sound insns hp) _ 6 53 _ _ _ _ assumed53 _ _
    hpath habs (by simpa only [Bool.and_eq_true] using hpins.1) hpins.2 s0 hasm hpc hcs hinit n hend

/-! ### Readable requirements for edge 53 -/

def num_accounts (s0 : State) : Nat := readByWidth s0.mem (INPUT_START + 0) .dword
def acct0_dup_marker (s0 : State) : Nat := readByWidth s0.mem (INPUT_START + 8) .byte
def acct0_data_len (s0 : State) : Nat := readByWidth s0.mem (INPUT_START + 88) .dword
def acct0_initialized_0 (s0 : State) : Nat := readByWidth s0.mem (INPUT_START + 96) .byte
def acct0_authority_8 (s0 : State) : Nat := readByWidth s0.mem (INPUT_START + 104) .dword
def acct0_authority_16 (s0 : State) : Nat := readByWidth s0.mem (INPUT_START + 112) .dword
def acct0_authority_24 (s0 : State) : Nat := readByWidth s0.mem (INPUT_START + 120) .dword
def acct0_authority_32 (s0 : State) : Nat := readByWidth s0.mem (INPUT_START + 128) .dword
def acct1_dup_marker (s0 : State) : Nat := readByWidth s0.mem (INPUT_START + 10392) .byte
def acct1_is_signer (s0 : State) : Nat := readByWidth s0.mem (INPUT_START + 10393) .byte
def acct1_key_0 (s0 : State) : Nat := readByWidth s0.mem (INPUT_START + 10400) .dword
def acct1_key_1 (s0 : State) : Nat := readByWidth s0.mem (INPUT_START + 10408) .dword
def acct1_key_2 (s0 : State) : Nat := readByWidth s0.mem (INPUT_START + 10416) .dword
def acct1_key_3 (s0 : State) : Nat := readByWidth s0.mem (INPUT_START + 10424) .dword
def acct1_data_len (s0 : State) : Nat := readByWidth s0.mem (INPUT_START + 10472) .dword
def ix_data_len (s0 : State) : Nat := readByWidth s0.mem (INPUT_START + 20728) .dword
def ix_data_0 (s0 : State) : Nat := readByWidth s0.mem (INPUT_START + 20736) .byte

/-- The input lengths edge 53's theorem assumes: account 0 has 48 data bytes (the program also checks this on every path); account 1 has 0 data bytes (an assumption: the program does not check it). The theorem says nothing
    about inputs with other lengths. -/
def lengths53 (s0 : State) : Prop :=
  acct0_data_len s0 = 48 ∧
    acct1_data_len s0 = 0

theorem assumed_of_lengths53 (s0 : State) (h : lengths53 s0) : AssumedHolds s0 assumed53 := by
  intro x hx
  simp only [assumed53, List.mem_cons, List.mem_nil_iff, or_false] at hx
  rcases hx with rfl | rfl <;> simp_all [lengths53, acct0_data_len, acct1_data_len]

/-- What every run to edge 53 checks, whatever the instruction. -/
def requires53 (s0 : State) : Prop :=
  num_accounts s0 ≠ 0 ∧
    acct0_dup_marker s0 = 255 ∧
    num_accounts s0 ≠ 1 ∧
    acct1_dup_marker s0 = 255 ∧
    num_accounts s0 = 2 ∧
    ix_data_len s0 ≠ 0

theorem requires53_of (s0 : State) (h : ∀ ig ∈ idom53, ig.holds s0) : requires53 s0 := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · have h := h (idom53[0]'(by decide)) (List.getElem_mem _)
